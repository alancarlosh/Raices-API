SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Deja sin definir para usar SQLite local. Para PostgreSQL:
# DATABASE_URL=postgres://usuario:password@localhost:5432/raices

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Base para las URLs de audio placeholder/ingerido servidas por Django (ver
# config/urls.py). En dev debe coincidir con el host:puerto de `runserver`. En
# Render, usa la URL pública real del servicio (ver sección "Despliegue en
# Render" del README) — hasta que el audio real se sirva desde un CDN.
MEDIA_BASE_URL=http://127.0.0.1:8000

# URL pública de Raices-Front, usada para construir el enlace de restablecer
# contraseña que se manda por correo (ver apps/accounts/services.py).
FRONTEND_URL=http://localhost:8080

# Envío de correo (recuperación de contraseña). Sin estas, EMAIL_BACKEND se
# queda en 'console' (el correo se imprime en el log del servidor, no se
# envía de verdad) — suficiente para dev local. Proveedor elegido para
# producción: Brevo (smtp-relay.brevo.com, ya es el default de EMAIL_HOST).
# DEFAULT_FROM_EMAIL=no-responder@raices.local
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
